diff --git a/src/open_llm_vtuber/tts/voicevox_tts.py b/src/open_llm_vtuber/tts/voicevox_tts.py
new file mode 100644
index 0000000..c5aa150
--- /dev/null
+++ b/src/open_llm_vtuber/tts/voicevox_tts.py
@@ -0,0 +1,49 @@
+import requests
+from loguru import logger
+from .tts_interface import TTSInterface
+
+
+# VOICEVOX engine (https://github.com/VOICEVOX/voicevox_engine): /audio_query then /synthesis, Japanese only.
+# Speaker ids: GET {url}/speakers
+class TTSEngine(TTSInterface):
+    def __init__(
+        self,
+        url="http://127.0.0.1:50021",
+        speaker=8,
+        speed=1.0,
+        pitch=0.0,
+        intonation=1.0,
+    ):
+        self.url = url.rstrip("/")
+        self.speaker = speaker
+        self.params = {
+            "speedScale": speed,
+            "pitchScale": pitch,
+            "intonationScale": intonation,
+        }
+        self.file_extension = "wav"
+        self.new_audio_dir = "cache"
+
+    def generate_audio(self, text, file_name_no_ext=None):
+        file_name = self.generate_cache_file_name(file_name_no_ext, self.file_extension)
+        try:
+            q = requests.post(
+                f"{self.url}/audio_query",
+                params={"text": text, "speaker": self.speaker},
+                timeout=30,
+            )
+            q.raise_for_status()
+            query = {**q.json(), **self.params}
+            r = requests.post(
+                f"{self.url}/synthesis",
+                params={"speaker": self.speaker},
+                json=query,
+                timeout=120,
+            )
+            r.raise_for_status()
+        except Exception as e:
+            logger.critical(f"VOICEVOX unable to generate audio (is the engine running on {self.url}?): {e}")
+            return None
+        with open(file_name, "wb") as f:
+            f.write(r.content)
+        return file_name
